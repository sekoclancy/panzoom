:{$CADDYPORT:4242} {
	encode gzip

	log {
		output stdout
		format console
		level INFO
	}

	# Quarto's accessibility check (quarto render --profile axe).
	redir /axe /axe/
	handle_path /axe/* {
		root * _site-axe/
		file_server
	}

	handle {
		root * docs/
		file_server
	}

	handle_errors {
		root * docs/
		rewrite /404.html
		file_server
	}
}
