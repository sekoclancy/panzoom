{
  "name": "panzoom-tests",
  "version": "1.0.0",
  "description": "Browser checks for the panzoom Quarto extension",
  "scripts": {
    "test": "node browser.mjs",
    "standalone": "node standalone.mjs && node browser.mjs standalone/*.html",
    "nojs": "node nojs.mjs",
    "contrast": "node contrast.mjs",
    "lightbox": "node lightbox-match.mjs",
    "a11y": "node a11y.mjs",
    "touch": "node touch.mjs",
    "loading": "node loading.mjs",
    "bench": "node bench.mjs",
    "bench:save": "node bench.mjs --save",
    "offline": "node standalone.mjs --offline && node browser.mjs --offline ../docs/examples/*.html standalone/*.html",
    "options": "node options.mjs",
    "demo": "node demo.mjs"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "axe-core": "4.14.0",
    "puppeteer-core": "^25.12.0"
  }
}
